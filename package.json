{
  "name": "extension-wishlist",
  "displayName": "Extension Wishlist",
  "description": "Bookmark VS Code Marketplace extensions to a wishlist so you can try them later — browse, save, and install only when you're ready.",
  "version": "1.0.0",
  "publisher": "wxgrzr",
  "license": "MIT",
  "author": "William Greer",
  "repository": {
    "type": "git",
    "url": "https://github.com/wxgrzr/vscode-extension-wishlist.git"
  },
  "bugs": {
    "url": "https://github.com/wxgrzr/vscode-extension-wishlist/issues"
  },
  "homepage": "https://github.com/wxgrzr/vscode-extension-wishlist#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "keywords": [
    "wishlist",
    "bookmark",
    "extension manager",
    "extensions",
    "marketplace",
    "favorites",
    "save for later",
    "browse extensions",
    "install later",
    "extension list"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "extensionWishlist",
          "title": "Extension Wishlist",
          "icon": "media/wishlist.svg"
        }
      ]
    },
    "views": {
      "extensionWishlist": [
        {
          "id": "extensionWishlist.list",
          "name": "Wishlist",
          "icon": "media/wishlist.svg",
          "contextualTitle": "Extension Wishlist"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "extensionWishlist.list",
        "contents": "Your wishlist is empty.\n\nOpen the Extensions view, right-click any extension and choose \"Add to Wishlist\" to save it to try later — without installing it now.\n\nOr add one by its id:\n[Add by Extension ID](command:extensionWishlist.addById)"
      }
    ],
    "commands": [
      {
        "command": "extensionWishlist.refresh",
        "title": "Refresh",
        "category": "Extension Wishlist",
        "icon": "$(refresh)"
      },
      {
        "command": "extensionWishlist.open",
        "title": "Open Extension Page",
        "category": "Extension Wishlist",
        "icon": "$(go-to-file)"
      },
      {
        "command": "extensionWishlist.openInMarketplace",
        "title": "Open in Marketplace",
        "category": "Extension Wishlist",
        "icon": "$(link-external)"
      },
      {
        "command": "extensionWishlist.uninstall",
        "title": "Uninstall Extension",
        "category": "Extension Wishlist",
        "icon": "$(trash)"
      },
      {
        "command": "extensionWishlist.remove",
        "title": "Remove from Wishlist",
        "category": "Extension Wishlist",
        "icon": "$(close)"
      },
      {
        "command": "extensionWishlist.addById",
        "title": "Add by Extension ID",
        "category": "Extension Wishlist",
        "icon": "$(add)"
      },
      {
        "command": "extensionWishlist.addFromMarketplace",
        "title": "Add to Wishlist",
        "category": "Extension Wishlist",
        "icon": "$(bookmark)"
      },
      {
        "command": "extensionWishlist.clearAll",
        "title": "Clear Wishlist",
        "category": "Extension Wishlist"
      }
    ],
    "configuration": {
      "title": "Extension Wishlist",
      "properties": {
        "extensionWishlist.showBadge": {
          "type": "boolean",
          "default": true,
          "description": "Show a badge on the Extension Wishlist activity bar icon with the number of wishlisted extensions."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "extensionWishlist.addById",
          "when": "view == extensionWishlist.list",
          "group": "navigation@1"
        },
        {
          "command": "extensionWishlist.refresh",
          "when": "view == extensionWishlist.list",
          "group": "navigation@2"
        },
        {
          "command": "extensionWishlist.clearAll",
          "when": "view == extensionWishlist.list",
          "group": "overflow@1"
        }
      ],
      "view/item/context": [
        {
          "command": "extensionWishlist.openInMarketplace",
          "when": "view == extensionWishlist.list && viewItem =~ /^wishlistItem/",
          "group": "inline@1"
        },
        {
          "command": "extensionWishlist.uninstall",
          "when": "view == extensionWishlist.list && viewItem == wishlistItem.installed",
          "group": "inline@2"
        },
        {
          "command": "extensionWishlist.remove",
          "when": "view == extensionWishlist.list && viewItem =~ /^wishlistItem/",
          "group": "inline@3"
        },
        {
          "command": "extensionWishlist.open",
          "when": "view == extensionWishlist.list && viewItem =~ /^wishlistItem/",
          "group": "navigation@1"
        },
        {
          "command": "extensionWishlist.openInMarketplace",
          "when": "view == extensionWishlist.list && viewItem =~ /^wishlistItem/",
          "group": "navigation@2"
        },
        {
          "command": "extensionWishlist.uninstall",
          "when": "view == extensionWishlist.list && viewItem == wishlistItem.installed",
          "group": "1_modify@1"
        },
        {
          "command": "extensionWishlist.remove",
          "when": "view == extensionWishlist.list && viewItem =~ /^wishlistItem/",
          "group": "1_modify@2"
        }
      ],
      "extension/context": [
        {
          "command": "extensionWishlist.addFromMarketplace",
          "group": "2_configure@1"
        }
      ],
      "commandPalette": [
        {
          "command": "extensionWishlist.addFromMarketplace",
          "when": "false"
        },
        {
          "command": "extensionWishlist.open",
          "when": "false"
        },
        {
          "command": "extensionWishlist.openInMarketplace",
          "when": "false"
        },
        {
          "command": "extensionWishlist.uninstall",
          "when": "false"
        },
        {
          "command": "extensionWishlist.remove",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run compile -- --sourcemap --watch",
    "package": "npm run compile -- --minify",
    "typecheck": "tsc --noEmit",
    "release": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5"
  }
}

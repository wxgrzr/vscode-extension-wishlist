{
  "name": "extension-wishlist",
  "displayName": "Extension Wishlist",
  "description": "Save VS Code Marketplace extensions to a wishlist to try later, without installing them.",
  "version": "0.1.0",
  "publisher": "v0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "wishlist",
    "marketplace",
    "extensions",
    "bookmark",
    "favorites"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "extensionWishlist",
          "title": "Extension Wishlist",
          "icon": "media/wishlist.svg"
        }
      ]
    },
    "views": {
      "extensionWishlist": [
        {
          "id": "extensionWishlist.list",
          "name": "Wishlist",
          "icon": "media/wishlist.svg",
          "contextualTitle": "Extension Wishlist"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "extensionWishlist.list",
        "contents": "Your wishlist is empty.\n\nSearch the Marketplace and bookmark extensions to try later, without installing them.\n[Search Marketplace](command:extensionWishlist.search)"
      }
    ],
    "commands": [
      {
        "command": "extensionWishlist.search",
        "title": "Search Marketplace",
        "category": "Extension Wishlist",
        "icon": "$(search)"
      },
      {
        "command": "extensionWishlist.refresh",
        "title": "Refresh",
        "category": "Extension Wishlist",
        "icon": "$(refresh)"
      },
      {
        "command": "extensionWishlist.openDetails",
        "title": "Open Details",
        "category": "Extension Wishlist"
      },
      {
        "command": "extensionWishlist.openInMarketplace",
        "title": "Open in Marketplace",
        "category": "Extension Wishlist",
        "icon": "$(link-external)"
      },
      {
        "command": "extensionWishlist.install",
        "title": "Install Extension",
        "category": "Extension Wishlist",
        "icon": "$(cloud-download)"
      },
      {
        "command": "extensionWishlist.remove",
        "title": "Remove from Wishlist",
        "category": "Extension Wishlist",
        "icon": "$(trash)"
      },
      {
        "command": "extensionWishlist.addById",
        "title": "Add by Extension ID",
        "category": "Extension Wishlist",
        "icon": "$(add)"
      },
      {
        "command": "extensionWishlist.addFromMarketplace",
        "title": "Add to Wishlist",
        "category": "Extension Wishlist",
        "icon": "$(bookmark)"
      },
      {
        "command": "extensionWishlist.clearAll",
        "title": "Clear Wishlist",
        "category": "Extension Wishlist"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "extensionWishlist.search",
          "when": "view == extensionWishlist.list",
          "group": "navigation@1"
        },
        {
          "command": "extensionWishlist.addById",
          "when": "view == extensionWishlist.list",
          "group": "navigation@2"
        },
        {
          "command": "extensionWishlist.refresh",
          "when": "view == extensionWishlist.list",
          "group": "navigation@3"
        },
        {
          "command": "extensionWishlist.clearAll",
          "when": "view == extensionWishlist.list",
          "group": "overflow@1"
        }
      ],
      "view/item/context": [
        {
          "command": "extensionWishlist.openInMarketplace",
          "when": "view == extensionWishlist.list && viewItem == wishlistItem",
          "group": "inline@1"
        },
        {
          "command": "extensionWishlist.install",
          "when": "view == extensionWishlist.list && viewItem == wishlistItem",
          "group": "inline@2"
        },
        {
          "command": "extensionWishlist.remove",
          "when": "view == extensionWishlist.list && viewItem == wishlistItem",
          "group": "inline@3"
        },
        {
          "command": "extensionWishlist.openDetails",
          "when": "view == extensionWishlist.list && viewItem == wishlistItem",
          "group": "context@1"
        },
        {
          "command": "extensionWishlist.openInMarketplace",
          "when": "view == extensionWishlist.list && viewItem == wishlistItem",
          "group": "context@2"
        },
        {
          "command": "extensionWishlist.install",
          "when": "view == extensionWishlist.list && viewItem == wishlistItem",
          "group": "context@3"
        },
        {
          "command": "extensionWishlist.remove",
          "when": "view == extensionWishlist.list && viewItem == wishlistItem",
          "group": "context@4"
        }
      ],
      "extension/context": [
        {
          "command": "extensionWishlist.addFromMarketplace",
          "group": "2_configure@1"
        }
      ],
      "commandPalette": [
        {
          "command": "extensionWishlist.addFromMarketplace",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run compile -- --sourcemap --watch",
    "package": "npm run compile -- --minify",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5"
  }
}
